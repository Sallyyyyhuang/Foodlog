<%= form_with(model: entry) do |form| %>
  <% if entry.errors.any? %>
    <div class="message is-danger">
      <div class="message-header">
        <p><%= pluralize(entry.errors.count, "error") %> prohibited this entry from being saved:</p>
      </div>
      <div class="message-body">
        <ul>
          <% entry.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# Food search %>
  <div class="field" data-controller="food-search">
    <label class="label">Search Food (optional)</label>
    <div class="control">
      <input type="text" class="input" placeholder="e.g. chicken breast"
             data-food-search-target="query"
             data-action="input->food-search#search" autocomplete="off">
    </div>
    <div class="box is-hidden mt-1 p-2" data-food-search-target="results"
         style="position:absolute;z-index:100;min-width:300px;max-height:250px;overflow-y:auto;">
    </div>

    <%# Hidden targets for auto-fill %>
    <span data-food-search-target="mealType" style="display:none"></span>
    <span data-food-search-target="calories" style="display:none"></span>
    <span data-food-search-target="proteins" style="display:none"></span>
    <span data-food-search-target="carbohydrates" style="display:none"></span>
    <span data-food-search-target="fats" style="display:none"></span>
  </div>

  <div class="field">
    <%= form.label :meal_type, class: "label" %>
    <%= form.text_field :meal_type, class: "input", data: { food_search_field: "meal_type" } %>
  </div>

  <div class="field">
    <%= form.label :calories, class: "label" %>
    <%= form.number_field :calories, class: "input", data: { food_search_field: "calories" } %>
  </div>

  <div class="field">
    <%= form.label :proteins, class: "label" %>
    <%= form.number_field :proteins, class: "input", data: { food_search_field: "proteins" } %>
  </div>

  <div class="field">
    <%= form.label :carbohydrates, class: "label" %>
    <%= form.number_field :carbohydrates, class: "input", data: { food_search_field: "carbohydrates" } %>
  </div>

  <div class="field">
    <%= form.label :fats, class: "label" %>
    <%= form.number_field :fats, class: "input", data: { food_search_field: "fats" } %>
  </div>

  <div class="action">
    <%= form.submit class:"button is-success" %>
  </div>
<% end %>
