<%# Date + clock header %>
<div class="has-text-centered mt-5 mb-2" data-controller="clock">
  <p class="is-size-4 has-text-weight-bold" style="color: #880e4f;" data-clock-target="date"></p>
  <p class="is-size-6" style="color: #c2185b;" data-clock-target="time"></p>
</div>

<%# Welcome banner %>
<div class="columns is-centered mt-5">
  <div class="column is-half">
    <div class="welcome-banner">
      <div class="columns is-vcentered is-mobile">
        <div class="column">
          <h2 class="title is-5 mb-1">Welcome to Foodlog!</h2>
          <p>Track your meals, activities, and hit your daily goals. Here's how:</p>
          <ul class="mt-1" style="list-style: none; padding: 0;">
            <li>🍽️ <strong>Create New Entry</strong> to log a meal — search food to auto-fill macros</li>
            <li>🏃 <strong>Activities</strong> to log exercise and see calories burned</li>
            <li>👤 <strong>Profile</strong> to set your stats and get a personalised calorie goal</li>
            <li>📅 <strong>View all entries</strong> for a weekly summary</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Calorie progress panel %>
<div class="columns is-centered">
  <div class="column is-half">
    <% profile = Profile.first %>
    <% if profile.nil? %>
      <div class="notification is-warning is-light">
        Set up your <%= link_to "profile", edit_profile_path %> to see your daily calorie goal.
      </div>
    <% else %>
      <% today_calories = @entries.sum(&:calories) %>
      <% goal = profile.daily_calorie_goal %>
      <% burned = Activity.today.sum(:calories_burned) %>
      <% net = today_calories - burned %>
      <% progress_pct = [[today_calories * 100 / goal, 100].min, 0].max %>

      <div class="box">
        <p class="heading">Daily Calories</p>
        <progress class="progress is-success mb-1" value="<%= progress_pct %>" max="100"></progress>
        <p class="has-text-centered">
          <strong><%= today_calories %></strong> / <%= goal %> kcal consumed
          &nbsp;&nbsp;|&nbsp;&nbsp;
          <span class="has-text-danger"><strong><%= burned %></strong> kcal burned</span>
          &nbsp;&nbsp;&rarr;&nbsp;&nbsp;
          Net: <strong><%= net %></strong> kcal
        </p>
      </div>
    <% end %>
  </div>
</div>

<%# Today's entries %>
<div class="columns mt-2 is-centered is-multiline">
  <% if @entries.empty? %>
    <div class="column is-half has-text-centered has-text-grey mt-4">
      <p style="font-size: 3rem;">🍱🍎🧋</p>
      <p>No entries yet today — log your first meal!</p>
    </div>
  <% else %>
    <% @entries.each do |entry| %>
    <div class="column is-one-quarter">
       <div class="card">
        <header class="card-header">
          <p class="card-header-title"><%= entry.meal_type %></p>
        </header>
        <div class="card-content">
          <div class="content">
             <p><span class="has-text-weight-bold"><%= entry.calories %></span> calories</p>
             <p><span class="has-text-weight-bold"><%= entry.proteins %></span>g protein</p>
             <p><span class="has-text-weight-bold"><%= entry.carbohydrates %></span>g carbs</p>
             <p><span class="has-text-weight-bold"><%= entry.fats %></span>g fats</p>
             <p class="is-size-7 has-text-grey">Logged <%= time_ago_in_words(entry.created_at) %> ago</p>
          </div>
        </div>
        <div class="card-footer">
           <%= link_to 'Show', entry, class: "card-footer-item" %>
           <%= link_to 'Edit', edit_entry_path(entry), class: "card-footer-item" %>
           <%= link_to 'Delete', entry, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "card-footer-item has-text-danger" %>
        </div>
       </div>
     </div>
    <% end %>
  <% end %>
</div>

<div class="has-text-centered mt-5 mb-6">
  <%= link_to "📅 View all entries", archives_index_path, class: "button is-link is-outlined" %>
</div>
